# Application environment (development | preview | production)
# Prefer this over NODE_ENV for environment-specific behaviour.
APP_ENV=development

# Canonical public site URL (HTTPS in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Local: Supabase CLI postgres URL (port 54422)
# Preview/staging: non-production Supabase project only
# Production: dedicated production project only
DATABASE_URL=

# Optional postgres.js pool size (1–10). Transaction pooler URLs default to 1.
DATABASE_POOL_MAX=

# Block accidental dev seed against the production Supabase project ref (db.<ref>.supabase.co)
PRODUCTION_SUPABASE_PROJECT_REF=

# --- Media / stock APIs (optional; server-side only) ---
CAR_DATABASE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APPLICATION_ID=

# --- Paystack ---
# CI/local tests: PAYSTACK_MOCK=1 (never with live secrets)
# Preview/staging: sk_test_* only
# Production: sk_live_* only after launch acceptance
#
# The app reads PAYSTACK_SECRET_KEY at runtime. Store test and live keys separately
# for reference; set PAYSTACK_SECRET_KEY to sk_test_* locally/CI/preview.
# PAYSTACK_LIVE_* is manual production only — never in CI, .env.example, or Vercel
# until the launch checklist is complete.
PAYSTACK_SECRET_KEY=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
# Optional. Defaults to NEXT_PUBLIC_APP_URL + /payment/callback when unset.
PAYSTACK_CALLBACK_URL=
PAYSTACK_MOCK=1

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
# Local/CI: capture emails to .email-outbox.json instead of sending
EMAIL_DEV_OUTBOX=1
# Staff inbox for new enquiry notifications (optional)
ENQUIRY_NOTIFICATION_EMAIL=

# --- Security ---
# HMAC secret for guest booking OTPs and session tokens (required in production)
BOOKING_OTP_SECRET=

# --- Cron / housekeeping ---
# Required when scheduling /api/cron/cleanup in production
CRON_SECRET=

# --- Testing / CI ---
TEST_STAFF_EMAIL=
TEST_STAFF_PASSWORD=

# --- Optional observability ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
